# 复制为 .env 后按本机情况修改。.env 已被 .gitignore 忽略，不要提交真实口令。

# ------------------------------ 服务 ------------------------------
PORT=8031
NODE_ENV=development

# ------------------------------ 数据库 ------------------------------
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=railway_term_learning_app
PGPASSWORD=change_me
PGDATABASE=railway_term_learning
PGPOOL_MAX=10
PGSSL=0
# Optional when PostgreSQL client tools are not on PATH.
PG_BIN_DIR=
ALLOW_DEMO_SEED=0
DB_BACKUP_ENCRYPTION_KEY=

# ------------------------------ 鉴权 ------------------------------
# 生产环境务必换成随机长串，否则任何人都能伪造 token
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h
# 找回密码验证码有效期（分钟）
RESET_CODE_TTL_MINUTES=10

# ------------------------- 智能体：Ollama -------------------------
# 本机 Ollama 服务地址与默认模型（须已在 Ollama 中 pull 过）
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen3:14b
# 单次对话最多回灌多少条历史消息，防止上下文无限增长
OLLAMA_HISTORY_LIMIT=20
# 推理超时（毫秒）。本地模型首次加载较慢，默认 5 分钟
OLLAMA_REQUEST_TIMEOUT=300000

# ---------------------- 智能体：AI 边车（语音） ----------------------
# 未启动边车时 asr/tts 自动降级为浏览器能力，主流程不受影响
AI_SIDECAR_URL=http://127.0.0.1:8090
AI_SIDECAR_ENABLED=true
# Whisper 模型规格。约：tiny 75MB / base 145MB / small 480MB / medium 1.5GB / large-v3 3GB
# small 是中越英三语的速度与准确率平衡点；追求质量且不赶时间可上 large-v3（24G 显存跑得动）。
# 注意 base 及以下中文会出现同音字错误（道岔 -> 倒插），只适合验证流程。
ASR_MODEL=small
ASR_TIMEOUT=120000
TTS_TIMEOUT=60000
# 单次上传音频上限（字节），默认 20MB
ASR_MAX_BYTES=20971520
# Whisper 权重下载源。直连 huggingface.co 在国内基本不通（会卡在 0 字节），务必设镜像。
HF_ENDPOINT=https://hf-mirror.com

# --------------------------- 邮件（SMTP） ---------------------------
# 不配置时：验证码写入操作日志，且在非生产环境通过接口回显，功能仍可用。
# 生产环境必须配置，否则用户收不到验证码。
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
